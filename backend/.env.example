# Supabase (Project Settings → API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=halaqah-tracker

# Supabase (Project Settings → Database → Connection string, "Session pooler" URI)
# Used only for the express-session store.
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:5432/postgres

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
SESSION_SECRET=replace-with-a-long-random-string

# URL of the deployed frontend (Vercel), used for CORS + socket.io origin
CLIENT_URL=http://localhost:5173

PORT=5000
NODE_ENV=development
